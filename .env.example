# OpenAI API Key (Required for LLM filtering & resume tailoring)
OPENAI_API_KEY=your_openai_api_key_here

# Apify API Token & Actor (Required for live LinkedIn job scraping)
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_LINKEDIN_ACTOR=bebity/linkedin-jobs-scraper

# Hunter.io API Key (Optional: for recruiter contact email lookup)
HUNTER_API_KEY=your_hunter_api_key_here

# Google Drive & Resume Settings
# RESUME_DOC_ID can be a Google Doc ID or a local file path (default: master_resume.md)
RESUME_DOC_ID=master_resume.md
DRIVE_FOLDER_ID=

# Search Configuration
JOB_SEARCH_QUERY="Machine Learning Engineer"
JOB_SEARCH_LOCATION="Remote"
MAX_JOBS=5
MIN_MATCH_SCORE=60
STRICT_CRITERIA="Must allow remote work. Discard if it requires active security clearance or >10 years experience."

SENDER_NAME="Ashish Kumar"
SENDER_EMAIL="ashishku1502@gmail.com"

# SMTP Email Configuration (Optional: for automated recruiter email dispatch)
# For Gmail: Use smtp.gmail.com:587 and generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ashishku1502@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here

# GitHub Sync Configuration (Optional: for automatic repo backup of output resumes & drafts)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=Ashishku1502/job_Serch_agent
GITHUB_BRANCH=main

# Discord Notifications (Optional)
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# LinkedIn Auto-Apply Configuration (Optional)
LINKEDIN_LI_AT_COOKIE=
APIFY_AUTO_APPLY_ACTOR=tony/linkedin-auto-apply


