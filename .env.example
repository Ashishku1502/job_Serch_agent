# OpenAI API Key (Required for LLM filtering & resume tailoring)
OPENAI_API_KEY=your_openai_api_key_here

# Apify API Token & Actor (Required for live LinkedIn job scraping)
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_LINKEDIN_ACTOR=bebity/linkedin-jobs-scraper

# Hunter.io API Key (Optional: for recruiter contact email lookup)
HUNTER_API_KEY=your_hunter_api_key_here

# Google Drive & Resume Settings
# RESUME_DOC_ID can be a Google Doc ID or a local file path (default: master_resume.md)
RESUME_DOC_ID=master_resume.md
DRIVE_FOLDER_ID=

# Search Configuration
JOB_SEARCH_QUERY="Machine Learning Engineer"
JOB_SEARCH_LOCATION="Remote"
MAX_JOBS=5
MIN_MATCH_SCORE=60

SENDER_NAME="Ashish Kumar"

# GitHub Sync Configuration (Optional: for automatic repo backup of output resumes & drafts)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=Ashishku1502/ai_job_agent
GITHUB_BRANCH=main

